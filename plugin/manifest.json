{
  "id": "fr.robinrahoual.rotate",
  "name": "Rotate",
  "version": "0.9.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "ipc": {
      "enablePluginCommunication": true
    },
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": []
    },
    "network": {
      "domains": [
        "https://api.github.com"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "rotatePanel",
      "label": {
        "default": "Rotate"
      },
      "minimumSize": {
        "width": 230,
        "height": 220
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 680
      }
    },
    {
      "type": "command",
      "id": "rotateDefault",
      "label": {
        "default": "Tourner la sélection en vertical (sens par défaut)"
      }
    },
    {
      "type": "command",
      "id": "rotateReset",
      "label": {
        "default": "Remettre la sélection à l'horizontale"
      }
    },
    {
      "type": "command",
      "id": "rotateUndo",
      "label": {
        "default": "Annuler la dernière opération Rotate"
      }
    }
  ]
}
