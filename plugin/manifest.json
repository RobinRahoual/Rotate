{
  "id": "fr.robinrahoual.rotate",
  "name": "Rotate",
  "version": "0.1.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "rotatePanel",
      "label": { "default": "Rotate" },
      "minimumSize": { "width": 240, "height": 220 },
      "preferredDockedSize": { "width": 280, "height": 360 },
      "preferredFloatingSize": { "width": 320, "height": 420 }
    }
  ]
}
